TTS_VOICE=alloy

# Sistema
DATA_DIR=/data
PORT=3000
NODE_ENV=production
MOCK=0
MAX_USD_PER_PROJECT=5
MAX_USD_PER_DAY=20
WHISPER_MODEL=medium
WHISPER_DIR=
RENDER_CONCURRENCY=2

# Zernio (Fase 9)
ZERNIO_API_KEY=

